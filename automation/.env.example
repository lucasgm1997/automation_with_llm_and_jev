# Copy to automation/.env and fill locally. .env is ignored by git.
TYPESAFE_API_KEY=

# Optional if dart from Flutter 3.38.5+ is already on PATH or .fvm/flutter_sdk.
# DART_BIN=/Users/YOUR_USER/fvm/versions/3.38.5/bin/dart

# Optional SDK paths for prepare_android_app / prepare-android.
# Uses PATH, ANDROID_HOME/ANDROID_SDK_ROOT, or standard macOS/Linux SDK locations.
# ANDROID_HOME=/Users/YOUR_USER/Library/Android/sdk
# ADB_BIN=/Users/YOUR_USER/Library/Android/sdk/platform-tools/adb
# EMULATOR_BIN=/Users/YOUR_USER/Library/Android/sdk/emulator/emulator
